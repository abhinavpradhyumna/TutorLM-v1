<Window x:Class="LocalRAGChatbotUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TutorLM - Your Very Own Assistant" Height="600" Width="500">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Name="ChatScroll">
            <StackPanel Name="ChatStack"/>
        </ScrollViewer>

        
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                
                <ColumnDefinition Width="60"/>
                
                <ColumnDefinition Width="60"/>
                
                <ColumnDefinition Width="80"/>
                
            </Grid.ColumnDefinitions>

            
            <TextBox x:Name="PromptBox" Height="30" Grid.Column="0"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Stretch"/>

            
            <Button Grid.Column="1"
                    Click="Send_Click"
                    Foreground="White" FontWeight="Bold">
                <Image Source="C:\Users\abhin\OneDrive\Pictures\icons.png"
                       Width="20" Height="20"/>
            </Button>

            
            <Button Grid.Column="2"
                    Click="Rag_Click"
                    Content="RAG"
                    Foreground="White" FontWeight="Bold"
                    Background="DarkSlateBlue"/>

            
            <Button Grid.Column="3"
                    Click="AddDocs_Click"
                    Content="Add Docs"
                    Foreground="White" FontWeight="Bold"
                    Background="DarkOliveGreen"/>
        </Grid>
        <Border
    Background="#80000000"
    Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVisibilityConverter}}">

            <Border
        Background="White"
        Padding="30"
        CornerRadius="10"
        Width="300"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

                <StackPanel>
                    <ProgressBar
                IsIndeterminate="True"
                Height="20"/>

                    <TextBlock
                Text="Adding Documents. Continue Conversation with Tutor"
                Margin="0,15,0,0"
                TextAlignment="Center"
                FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
